[Unit]
Description=Sage voice-command listener
# Start after the network is up (Whisper + Claude are remote API calls).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rahmi
WorkingDirectory=/home/rahmi/atlas-device/pi
ExecStart=/home/rahmi/atlas-device/pi/.venv/bin/python sage_listener.py
Restart=on-failure
RestartSec=5

# API keys — copy /home/rahmi/atlas-device/pi/sage.env.example to sage.env and fill in.
EnvironmentFile=/home/rahmi/atlas-device/pi/sage.env

# If a specific USB mic index is needed, override here or in sage.env:
#   SAGE_AUDIO_DEVICE=1

[Install]
WantedBy=graphical.target
