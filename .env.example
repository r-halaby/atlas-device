# Copy to .env and fill in real values for local dev.
# For Vercel, set these as environment variables in the Vercel dashboard.
# .env is gitignored — never commit it.

# ---- Runtime (kiosk) ----

# Convex deployment URL for the ideate app.
# Production: copy VITE_CONVEX_URL from the ideate app's Vercel env (app.ideatebetter.com).
# Dev: use your personal Convex dev deployment URL from the Convex dashboard.
# Example: https://balanced-kangaroo-123.convex.cloud
VITE_CONVEX_URL=

# Clerk M2M JWT for the kiosk. Mint with `npm run mint-token` (see below).
# For production, use CLERK_MACHINE_SECRET_KEY from the production Clerk dashboard
# (clerk.ideatebetter.com → Machine Applications → Atlas Kiosk).
VITE_CONVEX_AUTH_TOKEN=

# ---- Mint script only (never shipped to the Pi or Vercel) ----

# Machine Secret Key from the Clerk dashboard for the kiosk M2M application.
# Production Clerk dashboard: https://clerk.ideatebetter.com
# Starts with ak_live_... for production, ak_test_... for dev.
CLERK_MACHINE_SECRET_KEY=

# The Clerk organization id whose todos the kiosk should show.
# Find it in the Clerk dashboard under Organizations.
# Starts with org_...
CLERK_ORG_ID=

# ---- pi/sage_listener.py only (never used by the React app) ----

# For Whisper transcription of the button-hold audio capture.
OPENAI_API_KEY=

# For Claude intent parsing of the transcript.
ANTHROPIC_API_KEY=
