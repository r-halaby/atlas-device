# Copy to .env and fill in real values. .env is gitignored.

# ---- Runtime (kiosk) ----

# Convex deployment URL for the ideate app (dev deployment during development).
# Example: https://impressive-panda-42.convex.cloud
VITE_CONVEX_URL=

# Clerk M2M JWT for the kiosk. Mint with `npm run mint-token`.
VITE_CONVEX_AUTH_TOKEN=

# ---- Mint script only (never shipped to the Pi) ----

# Machine Secret Key from the Clerk dashboard for the kiosk M2M application.
# Starts with ak_...
CLERK_MACHINE_SECRET_KEY=

# The Clerk organization id whose todos the kiosk should show.
# Starts with org_...
CLERK_ORG_ID=
